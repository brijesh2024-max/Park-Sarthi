# Configuration names only. Do not commit real credentials.
# Hosted values belong in Sites runtime environment settings, followed by deployment.
# For local Worker development use an ignored .dev.vars file if needed.

# Keep demo until payment, refund, webhook, and host settlement readiness is verified.
PAYMENT_MODE=demo

# Additional live-mode interlock. Keep false until all launch checks pass.
LIVE_PAYMENTS_ENABLED=false

# Stable Site user IDs, comma-separated. An email address is not a user ID.
# Obtain your signed-in ID from GET /api/bootstrap. Empty means no application admins.
ADMIN_USER_IDS=

# Use a matching test key pair for PAYMENT_MODE=test.
# Live mode requires approved merchant credentials and the launch checks in LAUNCH-GUIDE.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A distinct secret shared with the Razorpay webhook configuration.
RAZORPAY_WEBHOOK_SECRET=
