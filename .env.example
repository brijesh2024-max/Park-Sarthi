# Render / local Next.js configuration. Never commit real credentials.
# On Render, APP_URL must equal the actual https://...onrender.com origin or custom domain.
APP_URL=http://127.0.0.1:5173

# Supabase Connect -> Session pooler (port 5432). URL-encode special password characters.
DATABASE_URL=
# Optional PEM root certificate from Supabase if required by your connection's CA.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server secret key (sb_secret_...); legacy service_role also supported.
# This variable retains its older name. Never use a NEXT_PUBLIC prefix for it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=parking-photos

# Supabase Auth user UUIDs, comma-separated. Empty means no administrators.
ADMIN_USER_IDS=

# Reservations remain unavailable until real payment and host settlement setup is complete.
PAYMENT_MODE=disabled
LIVE_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
